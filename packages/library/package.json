{
  "name": "@tradecanvas/chart",
  "version": "2.1.0",
  "type": "module",
  "description": "Open-source trading chart library for the web: candlestick to Renko charts, technical indicators, drawing tools, live exchange feeds, orders on the chart, bar replay. Canvas 2D or WebGL, TypeScript, no dependencies.",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bonguynvan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bonguynvan/tradecanvas.git",
    "directory": "packages/library"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "trading",
    "chart",
    "canvas",
    "candlestick",
    "ohlc",
    "indicators",
    "drawing-tools",
    "technical-analysis",
    "financial-chart",
    "real-time",
    "realtime",
    "fintech",
    "upbit",
    "krx",
    "kospi",
    "차트",
    "주식",
    "typescript",
    "charting-library",
    "trading-chart",
    "candlestick-chart",
    "stock-chart",
    "crypto",
    "webgl",
    "javascript",
    "bar-replay",
    "paper-trading",
    "trading-terminal"
  ],
  "homepage": "https://tradecanvas.dev/",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/widget/index.js",
      "require": "./dist/widget/index.cjs"
    },
    "./widget/locales": {
      "types": "./dist/widget/locales/index.d.ts",
      "import": "./dist/widget/locales/index.js",
      "require": "./dist/widget/locales/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tradecanvas/commons": "workspace:*",
    "@tradecanvas/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
