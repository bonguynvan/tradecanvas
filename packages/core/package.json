{
  "name": "@tradecanvas/core",
  "version": "2.4.0",
  "type": "module",
  "description": "The rendering engine of @tradecanvas/chart, the open-source trading chart library: viewport, Canvas 2D and WebGL renderers, indicators, drawing tools.",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bonguynvan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bonguynvan/tradecanvas.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "trading",
    "chart",
    "canvas",
    "types",
    "trading-chart",
    "candlestick-chart",
    "technical-analysis",
    "webgl",
    "tradecanvas"
  ],
  "homepage": "https://tradecanvas.dev/",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tradecanvas/commons": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
