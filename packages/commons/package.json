{
  "name": "@tradecanvas/commons",
  "version": "2.17.0",
  "type": "module",
  "description": "Shared types, themes and icons of TradeCanvas (@tradecanvas/chart), the open-source chart library for trading apps.",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bonguynvan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bonguynvan/tradecanvas.git",
    "directory": "packages/commons"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "trading",
    "chart",
    "canvas",
    "types",
    "trading-chart",
    "typescript",
    "tradecanvas"
  ],
  "homepage": "https://tradecanvas.dev/",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  }
}
